# Application Settings
APP_NAME=IP-Creator
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/ip_creator.db

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# File Storage
STORAGE_PATH=./data
IP_ASSETS_PATH=./data/ip_assets
LORA_MODELS_PATH=./data/lora_models
VIDEOS_PATH=./data/videos
MODELS_PATH=./data/models
HF_HUB_CACHE_PATH=./data/models/huggingface

# IP-Adapter Mode
# "original"    - h94/IP-Adapter (CLIP image features, compatible with LoRA)
# "faceid"      - h94/IP-Adapter-FaceID (insightface 512-dim embeddings, recommended)
# "faceid-plus" - h94/IP-Adapter-FaceID (insightface + CLIP ViT-H/14 ~3.94 GB, highest quality)
IP_ADAPTER_MODE=faceid

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-in-production

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Default LLM Settings
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_TIMEOUT=60

# GPU Settings
GPU_MEMORY_LIMIT=6  # GB
MAX_CONCURRENT_TASKS=2
